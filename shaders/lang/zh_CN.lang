            option.SKY0_TB.comment = 日暮天空颜色的蓝色通道.
            
            option.SKY0_TI = 天空强度
            option.SKY0_TI.comment = 日暮天空颜色的强度.

        screen.FOG_SETTINGS0 = 雾设置
        screen.FOG_SETTINGS0.comment = §7主世界的雾密度和颜色设置.
            option.FOG0_VERTICAL_DENSITY_D = 垂直密度白天
            option.FOG0_VERTICAL_DENSITY_D.comment = 白天的垂直雾密度. 值越高 = 高高度雾越薄, 低高度越厚.
            
            option.FOG0_VERTICAL_DENSITY_N = 垂直密度夜晚
            option.FOG0_VERTICAL_DENSITY_N.comment = 夜晚的垂直雾密度.
            
            option.FOG0_VERTICAL_DENSITY_T = 垂直密度日暮
            option.FOG0_VERTICAL_DENSITY_T.comment = 日暮的垂直雾密度.
            
            option.FOG0_TOTAL_DENSITY = 总体密度
            option.FOG0_TOTAL_DENSITY.comment = 主世界的总体雾密度. 值越高 = 雾越厚.

            option.DYNAMIC_FOG = 动态迷雾
            option.DYNAMIC_FOG.comment = 启用随动态天气系统演变并基于生物群系湿度概率的动态迷雾. 沼泽、河流与雨林等高湿度群系更容易产生浓郁晨雾与漫布薄雾, 干燥群系则保持通透清朗.

            option.PALE_GARDEN_FOG = 苍白之园迷雾
            option.PALE_GARDEN_FOG.comment = 苍白之园生物群系中的浅灰色大气迷雾强度.

    screen.NETHER_SETTINGS = 下界设置
    screen.NETHER_SETTINGS.comment = §c下界雾和天空的颜色配置.
        option.FOGn1_VERTICAL_DENSITY = 垂直密度
        option.FOGn1_VERTICAL_DENSITY.comment = 下界的垂直雾密度. 值越高 = 高高度雾越薄, 低高度越厚.

        option.FOGn1_TOTAL_DENSITY = 总体密度
        option.FOGn1_TOTAL_DENSITY.comment = 下界的总体雾密度. 值越高 = 雾越厚.

        option.WORLDn1_VANILLA_FOGCOLI = 天空强度
        option.WORLDn1_VANILLA_FOGCOLI.comment = 下界原版雾颜色的强度.

