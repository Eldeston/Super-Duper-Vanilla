        option.SKY1_CB = End Dimension Sky Blue
        option.SKY1_CB.comment = Blue channel for the End void sky dome.\n\n§e[Visual] §fControls the deep indigo space tones of the End void.\n§a[Performance: None] §fColor channel scalar.

        option.SKY1_CI = End Dimension Sky Intensity
        option.SKY1_CI.comment = Master brightness multiplier for the End sky dome.\n\n§e[Visual] §fLightens or deepens the cosmic backdrop of the End.\n§a[Performance: None] §fIntensity scalar.

        option.WORLD1_CUSTOM_SKYLIGHT = End Ambient Skylight
        option.WORLD1_CUSTOM_SKYLIGHT.comment = Ambient sky illumination throughout the End dimension.\n\n§e[Visual] §fPrevents the undersides of End islands from falling into pitch-black void.\n§a[Performance: None] §fAmbient scalar.\n§b[Tip] §7Default 0.65 provides great visibility for navigating floating void islands.

        option.END_BH_LIGHT = Black Hole Directional Light
        option.END_BH_LIGHT.comment = Intensity of the permanent directional light beam cast from the cosmic Black Hole.\n\n§e[Visual] §fCasts faint, eerie directional highlights from the black hole accretion disk.\n§a[Performance: None] §fLight intensity scalar.\n§b[Tip] §7Gives the End dimension a mysterious, singular cosmic light source!

        option.FOG1_VERTICAL_DENSITY = End Vertical Fog Density
        option.FOG1_VERTICAL_DENSITY.comment = Altitude-dependent fog falloff in the End void.\n\n§e[Visual] §fControls fog density settling beneath the floating islands.\n§a[Performance: None] §fHeight falloff scalar.

        option.FOG1_TOTAL_DENSITY = End Total Fog Density
        option.FOG1_TOTAL_DENSITY.comment = Master atmospheric fog density throughout the End dimension.\n\n§e[Visual] §fHigher values wrap distant End cities in mysterious purple void mist.\n§a[Performance: None] §fFog density scalar.\n§b[Tip] §70.005 keeps outer End islands visible while preserving cosmic depth.

        option.END_BOSS_FOG = Ender Dragon Boss Fog
        option.END_BOSS_FOG.comment = Dramatic atmospheric boss fog intensity during the Ender Dragon encounter.\n\n§e[Visual] §fFills the central island with dense, dramatic purple fog during the dragon fight!\n§a[Performance: None] §fBoss phase fog multiplier.\n§b[Tip] §7Transforms the climactic dragon battle into a cinematic epic!

        option.END_SKY_TEXTURE_BRIGHTNESS = End Sky Texture Brightness
        option.END_SKY_TEXTURE_BRIGHTNESS.comment = Brightness of the custom background cosmic sky texture in the End.\n\n§e[Visual] §fLower values produce a deep dark void; higher values reveal cosmic star dust.\n§a[Performance: None] §fTexture brightness multiplier.
