## Language format v1.1.5
## All other .lang files must update to the latest language format version on this main .lang file

## Profiles
profile.comment = Changes the performance profile to improve performance or quality. §bApplying a profile changes the settings it defines.§r

profile.POTATO = Potato
profile.LOW = Low
profile.MEDIUM = Medium (Default)
profile.HIGH = High
profile.ULTRA = Ultra

screen.DEBUG = Super Duper Vanilla v1.3.9
screen.DEBUG.comment = Developed by §aEldeston§r, presented by §bFlameRender (C) Studios§r. §dClick me to open more settings: color mode and noise speed.§r
    option.COLOR_MODE = Color mode
    option.COLOR_MODE.comment = Changes the §dalbedo color mode§r: Off, White Mode, Black Mode or Foliage Mode.
        value.COLOR_MODE.0 = OFF
        value.COLOR_MODE.1 = White Mode
        value.COLOR_MODE.2 = Black Mode
        value.COLOR_MODE.3 = Foliage Mode

    option.NOISE_SPEED = Noise speed
    option.NOISE_SPEED.comment = Changes the §dtemporal noise speed§r.

screen.POST = Post
screen.POST.comment = Post-processing effects: outlines, anti-aliasing, retro filter, and image sharpening.
    option.OUTLINES = Outlines
    option.OUTLINES.comment = Enables outlines. Standard gives classic outlined blocks; Dungeons gives Dungeons/SDGP styled outlines.
        value.OUTLINES.0 = OFF
        value.OUTLINES.1 = Standard
        value.OUTLINES.2 = Dungeons

    option.OUTLINE_BRIGHTNESS = Outline brightness
    option.OUTLINE_BRIGHTNESS.comment = Outline brightness. Set it to -1 for black outlines, or 1 for highlighted outlines. §bOnly used when Outlines is not Off.§r

    option.OUTLINE_PIXEL_SIZE = Outline pixel size
    option.OUTLINE_PIXEL_SIZE.comment = Outline pixel size. Adjust to change the thickness of the outlines. §bOnly used when Outlines is not Off.§r

    option.RETRO_FILTER = Retro filter
    option.RETRO_FILTER.comment = Enables the retro filter. Works best at low render quality.

    option.ANTI_ALIASING = Anti aliasing
    option.ANTI_ALIASING.comment = Anti-aliasing mode. FXAA is fast and works with screenshot sizes. TAA is slower and smooths noise, but §bdoes not work with custom-resolution screenshots§r. Lite TAA + FXAA runs TAA without projection jitter, followed by FXAA. Profiles use §aFXAA§r for Potato and Low, and §eTAA§r from Medium.
        value.ANTI_ALIASING.0 = OFF
        value.ANTI_ALIASING.1 = FXAA
        value.ANTI_ALIASING.2 = TAA
        value.ANTI_ALIASING.3 = Lite TAA + FXAA

    option.SHARPEN_FILTER = Sharpen filter
    option.SHARPEN_FILTER.comment = Enables image sharpening. Use this if the image appears blurry. §bOnly applies when anti-aliasing is not Off.§r §cHigh performance impact.§r

    screen.CAMERA = Camera settings
    screen.CAMERA.comment = Camera and lens effects: depth of field, chromatic aberration, bloom, lens flare, vignette, and motion blur.
        option.DOF = Depth of field
        option.DOF.comment = Enables depth of field. Works better with anti-aliasing on.

        option.DOF_STRENGTH = Depth of field strength
        option.DOF_STRENGTH.comment = Depth of field strength. §bOnly used when Depth of field is On.§r

        option.CHROMATIC_ABERRATION = Chromatic aberration
        option.CHROMATIC_ABERRATION.comment = Enables chromatic aberration.

        option.ABERRATION_PIXEL_SIZE = Aberration pixel size
        option.ABERRATION_PIXEL_SIZE.comment = Chromatic aberration length. Increase for stronger effects. §bOnly used when Chromatic aberration is On.§r

        option.BLOOM = Bloom
        option.BLOOM.comment = Enables bloom. §aLow performance impact.§r

        option.BLOOM_STRENGTH = Bloom strength
        option.BLOOM_STRENGTH.comment = Bloom brightness. §bOnly used when Bloom is On.§r

        option.LENS_FLARE = Lens flare
        option.LENS_FLARE.comment = Enables lens flare.

        option.LENS_FLARE_STRENGTH = Lens flare strength
        option.LENS_FLARE_STRENGTH.comment = Lens flare intensity. §bOnly used when Lens flare is On.§r

        option.VIGNETTE = Vignette
        option.VIGNETTE.comment = Enables vignette.

        option.VIGNETTE_STRENGTH = Vignette strength
        option.VIGNETTE_STRENGTH.comment = Vignette intensity. §bOnly used when Vignette is On.§r

        option.MOTION_BLUR = Motion blur
        option.MOTION_BLUR.comment = Enables motion blur.

        option.MOTION_BLUR_STRENGTH = Motion blur strength
        option.MOTION_BLUR_STRENGTH.comment = Motion blur strength. §bOnly used when Motion blur is On.§r

    screen.TONEMAP = Tonemap settings
    screen.TONEMAP.comment = Tonemapping and color grading: contrast, saturation, white point, shoulder strength, exposure, and color tint.
        option.CONTRAST = Contrast
        option.CONTRAST.comment = Controls color contrast.

        option.SATURATION = Saturation
        option.SATURATION.comment = Controls color saturation.

        option.WHITE_POINT = White point
        option.WHITE_POINT.comment = Tonemap white point.

        option.SHOULDER_STRENGTH = Shoulder strength
        option.SHOULDER_STRENGTH.comment = Tonemap shoulder strength.

        option.AUTO_EXPOSURE = Auto exposure
        option.AUTO_EXPOSURE.comment = Enables real-time auto exposure. §bDoes not work with custom-resolution screenshots.§r

        option.AUTO_EXPOSURE_SPEED = Auto exposure speed
        option.AUTO_EXPOSURE_SPEED.comment = How fast auto exposure adjusts to the screen's exposure. Smaller values are slower, bigger values are faster. §bOnly used when Auto exposure is On.§r

        option.EXPOSURE = Exposure
        option.EXPOSURE.comment = Controls color exposure.

        option.MINIMUM_EXPOSURE = Min exposure
        option.MINIMUM_EXPOSURE.comment = Lowest exposure auto exposure can reach. Lower values brighten dark scenes more. §bOnly used when Auto exposure is On.§r

        option.TINT_R = Red tint
        option.TINT_R.comment = Red tint value.

        option.TINT_G = Green tint
        option.TINT_G.comment = Green tint value.

        option.TINT_B = Blue tint
        option.TINT_B.comment = Blue tint value.

screen.LIGHTING = Lighting
screen.LIGHTING.comment = Lighting and shadows: shadow mapping, shadow color and filter, entity shadows, underwater caustics, SSAO, ambient lighting, and the shadow map resolution, distance, and light path angle. §bUnderwater caustics need Shadowmap color to be On.§r
    option.SHADOW_MAPPING = Shadowmapping
    option.SHADOW_MAPPING.comment = Enables shadow mapping. Disable to use fake shadows from the lightmap. §aLow performance impact.§r

    option.SHADOW_COLOR = Shadowmap color
    option.SHADOW_COLOR.comment = Enables shadow color from colored transparent objects. §bNeeds Shadowmapping.§r §eMedium performance impact.§r

    option.SHADOW_FILTER = Shadowmap filter
    option.SHADOW_FILTER.comment = Enables soft shadow filtering: shadows appear softer by using noise. §bNeeds Shadowmapping.§r §eMedium performance impact.§r

    option.ENTITY_SHADOWS = Entity shadows
    option.ENTITY_SHADOWS.comment = Enables entity shadows. §bNeeds Shadowmapping.§r

    option.BLOCK_ENTITY_SHADOWS = Block entity shadows
    option.BLOCK_ENTITY_SHADOWS.comment = Enables block entity shadows. §bNeeds Shadowmapping.§r

    option.shadowMapResolution = Shadowmap resolution
    option.shadowMapResolution.comment = Shadowmap resolution. Higher values give sharper shadows at a higher cost. Profiles use §a512§r (Low), §e1024§r (Medium), §c2048§r (High) and §c4096§r (Ultra). §bNeeds Shadowmapping.§r

    option.shadowDistance = Shadowmap distance
    option.shadowDistance.comment = Shadowmap distance in blocks. Higher values stretch the shadow map farther at the cost of sharpness. It's recommended to match it with your render distance. §bNeeds Shadowmapping.§r

    option.sunPathRotation = Light path angle
    option.sunPathRotation.comment = Light path angle. This also affects the sky angle.

    option.UNDERWATER_CAUSTICS = Underwater caustics
    option.UNDERWATER_CAUSTICS.comment = Underwater caustics: Off, Underwater only, or Full. The cost rises with the mode: §eUnderwater§r is used from the Medium profile and §cFull§r from Ultra. §bRequires Shadowmap color.§r
        value.UNDERWATER_CAUSTICS.0 = OFF
        value.UNDERWATER_CAUSTICS.1 = Underwater
        value.UNDERWATER_CAUSTICS.2 = Full

    option.SSAO = SSAO
    option.SSAO.comment = Enables screen space ambient occlusion. §eMedium performance impact.§r

    option.AMBIENT_LIGHTING = Ambient lighting
    option.AMBIENT_LIGHTING.comment = Overall ambient lighting value. Increase if you dislike the pitch black darkness, higher values may make lighting unrealistic. Set it to zero for a more realistic look if you have SSGI enabled. Set it to 0.50 for night vision.

    screen.RAY_TRACING = Ray tracing settings
    screen.RAY_TRACING.comment = Screen-space ray tracing: SSGI, SSR, raytracer steps, rough reflections, and the previous frame buffer. §bRaytracer steps only matter while SSR or SSGI is On.§r
        option.SSGI = SSGI
        option.SSGI.comment = Enables screen space global illumination for more realistic indirect lighting. §bExperimental. Works best with TAA.§r

        option.SSR = SSR
        option.SSR.comment = Enables screen space reflections for reflective surfaces like water and metals. §aLow performance impact.§r

        option.RAYTRACER_STEPS = Raytracer steps
        option.RAYTRACER_STEPS.comment = Number of steps for ray tracing. Higher values increase quality but reduce performance. Profiles use §a8§r (Low), §e16§r (Medium), §c32§r (High) and §c64§r (Ultra). §bOnly used by SSR and SSGI.§r

        option.RAYTRACER_BISTEPS = Raytracer refinement steps
        option.RAYTRACER_BISTEPS.comment = Number of refinement steps for ray tracing. Improves detail in reflections and GI. Profiles use §a2§r (Low) and §e4§r (Medium and above). §bOnly used by SSR and SSGI.§r

        option.ROUGH_REFLECTIONS = Rough reflections
        option.ROUGH_REFLECTIONS.comment = Enables rougher objects to have rougher, blurred reflections. May show artifacts, which some anti-aliasing can hide. §eMedium performance impact.§r

        option.PREVIOUS_FRAME = Previous frame buffer
        option.PREVIOUS_FRAME.comment = Uses the previous frame's colors so SSR and SSGI get temporal accumulation and infinite bounces of light. §bOnly affects SSR and SSGI.§r §eMedium performance impact.§r

screen.ATMOSPHERICS = Atmospherics
screen.ATMOSPHERICS.comment = Atmospheric effects: sun and moon, volumetric lighting, border fog, ground fog, skybox brightness, and the cloud settings.
    option.SUN_MOON_TYPE = Sun/moon type
    option.SUN_MOON_TYPE.comment = Sun and moon shape: Squircle, Round or Vanilla. Also shapes the sun and moon reflection on surfaces. §bVanilla only applies in dimensions where Celestial body is Sun and moon, Directional light is On and Day cycle is On.§r
        value.SUN_MOON_TYPE.0 = Squircle
        value.SUN_MOON_TYPE.1 = Round
        value.SUN_MOON_TYPE.2 = Vanilla
    
    option.CLOUD_TYPE = Cloud type
    option.CLOUD_TYPE.comment = Changes cloud type: Vanilla clouds or shader Voxel clouds. Profiles use Vanilla for Potato and §aVoxel§r from Low.
        value.CLOUD_TYPE.0 = Vanilla
        value.CLOUD_TYPE.1 = Voxel

    option.SUN_MOON_INTENSITY = Sun/moon intensity
    option.SUN_MOON_INTENSITY.comment = The sun or moon's intensity. §bAlso affects specular reflections.§r

    option.VOLUMETRIC_LIGHTING = Volumetric lighting
    option.VOLUMETRIC_LIGHTING.comment = Enables volumetric lighting. §eMedium performance impact.§r

    option.VOLUMETRIC_LIGHTING_STRENGTH = Volumetric lighting strength
    option.VOLUMETRIC_LIGHTING_STRENGTH.comment = The strength of volumetric lighting. Set it to zero to disable it.

    option.BORDER_FOG = Border fog
    option.BORDER_FOG.comment = Enables border fog to cover world edges.

    option.GROUND_FOG_STRENGTH = Ground fog strength
    option.GROUND_FOG_STRENGTH.comment = The strength of mist/ground fog.

    screen.CLOUD_SETTINGS = Cloud settings
    screen.CLOUD_SETTINGS.comment = Cloud options: type, double layered clouds, dynamic clouds, fade speed, second cloud height, and thickness. §bThickness only applies to Voxel clouds.§r
        option.DOUBLE_LAYERED_CLOUDS = Double layered clouds
        option.DOUBLE_LAYERED_CLOUDS.comment = Adds another layer of clouds (works on both vanilla and shader clouds), may use up performance.

        option.DYNAMIC_CLOUDS = Dynamic clouds
        option.DYNAMIC_CLOUDS.comment = Makes clouds more dynamic and allows weather to affect them (works on both vanilla and voxel clouds).

        option.FADE_SPEED = Fade speed
        option.FADE_SPEED.comment = Cloud fade speed.

        option.SECOND_CLOUD_HEIGHT = 2nd cloud height
        option.SECOND_CLOUD_HEIGHT.comment = Height of the 2nd cloud layer. §bOnly used when Double layered clouds is On.§r

        option.CLOUD_THICKNESS = Cloud thickness
        option.CLOUD_THICKNESS.comment = Thickness of the voxel clouds in blocks. §bOnly applies to Voxel clouds.§r

    option.SKYBOX_BRIGHTNESS = Skybox brightness
    option.SKYBOX_BRIGHTNESS.comment = Sky box brightness. §bOnly applies in dimensions where Skybox is On.§r

screen.WORLD = World
screen.WORLD.comment = World animation and environment: terrain, water, and weather animation, timelapse mode, wind and current speed and frequency, and world curvature.
    option.TERRAIN_ANIMATION = Terrain animation
    option.TERRAIN_ANIMATION.comment = Enables terrain waving animation.

    option.WATER_ANIMATION = Water animation
    option.WATER_ANIMATION.comment = Enables water waving animation.

    option.WEATHER_ANIMATION = Weather animation
    option.WEATHER_ANIMATION.comment = Enables rain waving animation.

    option.TIMELAPSE_MODE = Timelapse mode
    option.TIMELAPSE_MODE.comment = Enables timelapse mode. This smoothens the transition of animations of the sky, the foliage waving etc. according to the current world time instead of frame time. Fragment applies it to water normals and the sky only; Full also applies it to waves. §bDoes not affect vanilla clouds, the skybox, or the sun and moon.§r
        value.TIMELAPSE_MODE.0 = OFF
        value.TIMELAPSE_MODE.1 = Fragment
        value.TIMELAPSE_MODE.2 = Full

    option.WIND_SPEED = Wind speed
    option.WIND_SPEED.comment = Adjust wind speed. Affects plants, swinging objects, and weather. Increases the animation speed.

    option.CURRENT_SPEED = Current speed
    option.CURRENT_SPEED.comment = Adjust liquid and underwater flow speed. Affects underwater plants and liquids. Increases the animation speed.

    option.WIND_FREQUENCY = Wind frequency
    option.WIND_FREQUENCY.comment = Adjust wind frequency. Affects plants, swinging objects, and weather. Increases the animation change frequency.

    option.CURRENT_FREQUENCY = Current frequency
    option.CURRENT_FREQUENCY.comment = Adjust liquid and underwater flow frequency. Affects underwater plants and liquids. Increases the animation change frequency.

    option.WORLD_CURVATURE = World curvature
    option.WORLD_CURVATURE.comment = Enables world curvature.

    option.WORLD_CURVATURE_SIZE = World curvature size
    option.WORLD_CURVATURE_SIZE.comment = World curvature size. §bOnly used when World curvature is On.§r

screen.PBR = PBR
screen.PBR.comment = Physically based rendering: PBR mode, specular highlights, environment materials, subsurface scattering, emissives, normals, and directional lightmaps, plus the parallax occlusion and iPBR material screens. Resource PBR §brequires a LabPBR 1.3 resource pack§r.
    option.PBR_MODE = PBR mode
    option.PBR_MODE.comment = Enables PBR. Basic and Integrated PBR map out materials from the vanilla albedo textures; Integrated PBR also gives stone, soil and similar blocks rough-reflection smoothness when Rough reflections is On. Lab PBR 1.3 uses your resource pack's PBR textures and §brequires a LabPBR 1.3 resource pack§r. Profiles use §aBasic PBR§r for Low and Medium, and §cIntegrated PBR§r from High.
        value.PBR_MODE.0 = OFF
        value.PBR_MODE.1 = Basic PBR
        value.PBR_MODE.2 = Integrated PBR
        value.PBR_MODE.3 = Lab PBR 1.3

    option.SPECULAR_HIGHLIGHTS = Specular highlights
    option.SPECULAR_HIGHLIGHTS.comment = Enables specular highlights: the approximate reflections of the sun and moon on surfaces.

    option.ENVIRONMENT_PBR = Enviro PBR materials
    option.ENVIRONMENT_PBR.comment = Enables environment materials, which react to your surroundings, such as rain wetness. §bRain wetness needs Weather to be On in the dimension.§r

    option.SUBSURFACE_SCATTERING = Subsurface scattering
    option.SUBSURFACE_SCATTERING.comment = Enables subsurface scattering on thin and organic materials, such as leaves.

    option.EMISSIVE_INTENSITY = Emissive intensity
    option.EMISSIVE_INTENSITY.comment = Emissive maps intensity. Does not affect lightmaps. §bRequires PBR to be on.§r

    option.NORMAL_STRENGTH = Normal strength
    option.NORMAL_STRENGTH.comment = Normal map strength. §bApplies to Lab PBR normal maps and auto-generated normals.§r

    option.SLOPE_NORMALS = Slope normals
    option.SLOPE_NORMALS.comment = Enables sharper slope normals for parallax occlusion surfaces. Disable this if you use a high resolution pack with normal maps.

    option.DIRECTIONAL_LIGHTMAPS = Directional lightmaps
    option.DIRECTIONAL_LIGHTMAPS.comment = Enables directional lightmaps. §bRequires auto-generated normals or PBR normals.§r

    option.DIRECTIONAL_LIGHTMAP_STRENGTH = Directional lightmaps strength
    option.DIRECTIONAL_LIGHTMAP_STRENGTH.comment = Directional lightmap strength. §bOnly used when Directional lightmaps is On.§r

    screen.POM_SETTINGS = Parallax occlusion settings
    screen.POM_SETTINGS.comment = Parallax occlusion mapping and parallax self-shadowing. §bRequires PBR mode Lab PBR 1.3 and a LabPBR resource pack.§r
        option.PARALLAX_OCCLUSION = Parallax occlusion
        option.PARALLAX_OCCLUSION.comment = Enables parallax occlusion mapping for simulated surface depth and detail. §bRequires Lab PBR 1.3 and a LabPBR resource pack.§r

        option.PARALLAX_DEPTH = Parallax depth
        option.PARALLAX_DEPTH.comment = Maximum depth of parallax occlusion mapping. Higher values increase the effect. §bOnly used when Parallax occlusion is On.§r

        option.PARALLAX_STEPS = Parallax steps
        option.PARALLAX_STEPS.comment = Number of steps for parallax occlusion mapping. More steps improve quality but reduce performance. §bOnly used when Parallax occlusion is On.§r

        option.PARALLAX_SHADOW = Parallax shadows
        option.PARALLAX_SHADOW.comment = Enables self-shadowing for parallax occlusion mapped surfaces. §bOnly used when Parallax occlusion is On.§r

        option.PARALLAX_SHADOW_STEPS = Parallax shadow steps
        option.PARALLAX_SHADOW_STEPS.comment = Number of steps for parallax shadowing. Higher values improve shadow detail. §bOnly used when Parallax shadows is On.§r

    screen.IPBR_SETTINGS = iPBR settings
    screen.IPBR_SETTINGS.comment = Material settings for water, lava, sculk, and auto-generated normals. §bAuto gen normals are disabled when using Lab PBR 1.3.§r
        screen.WATER_SETTINGS = Water material settings
        screen.WATER_SETTINGS.comment = Water material: noise, brightness, normal map, normal map blur and depth size, tile size, absorption, foam, and flat albedo.
            option.WATER_NOISE = Water noise
            option.WATER_NOISE.comment = Varies the water brightness with noise, similar to SDGP.

            option.WATER_BRIGHTNESS = Water brightness
            option.WATER_BRIGHTNESS.comment = Water brightness. Lower values mean deeper colors.

            option.WATER_NORMAL = Water normalmap
            option.WATER_NORMAL.comment = Enables water surface normals.

            option.WATER_BLUR_SIZE = Water normalmap blur size
            option.WATER_BLUR_SIZE.comment = Blur size of the water normal map. Smaller values give more defined waves, larger values smoother waves. §bOnly used when Water normalmap is On.§r

            option.WATER_DEPTH_SIZE = Water normalmap depth size
            option.WATER_DEPTH_SIZE.comment = Depth of the waves in the water normal map. Smaller values give more depth. §bOnly used when Water normalmap is On.§r

            option.WATER_TILE_SIZE = Water tile size
            option.WATER_TILE_SIZE.comment = Tile size of the water.

            option.WATER_STYLIZE_ABSORPTION = Water absorption
            option.WATER_STYLIZE_ABSORPTION.comment = Enables stylized water absorption, which changes the water color based on depth.

            option.WATER_FOAM = Water foam
            option.WATER_FOAM.comment = Enables water foam. Appears on the sides of most solid objects, including entities.

            option.WATER_FLAT = Flat water albedo
            option.WATER_FLAT.comment = Uses a flat albedo color for water, ignoring texture details.

        screen.LAVA_SETTINGS = Lava material settings
        screen.LAVA_SETTINGS.comment = Lava material: brightness, noise, and tile size.
            option.LAVA_BRIGHTNESS = Lava brightness
            option.LAVA_BRIGHTNESS.comment = Lava brightness. Lower values mean darker colors.

            option.LAVA_NOISE = Lava noise
            option.LAVA_NOISE.comment = Varies the lava brightness with noise, similar to Minecraft Dungeons.

            option.LAVA_TILE_SIZE = Lava tile size
            option.LAVA_TILE_SIZE.comment = Tile size of the lava.

        screen.SCULK_SETTINGS = Sculk material settings
        screen.SCULK_SETTINGS.comment = Sculk material: brightness, noise, and tile size.
            option.SCULK_BRIGHTNESS = Sculk brightness
            option.SCULK_BRIGHTNESS.comment = Sculk brightness. Lower values mean darker colors.

            option.SCULK_NOISE = Sculk noise
            option.SCULK_NOISE.comment = Varies the sculk emissives with noise.

            option.SCULK_TILE_SIZE = Sculk tile size
            option.SCULK_TILE_SIZE.comment = Tile size of the sculk.

        option.NORMAL_GENERATION = Auto gen normals
        option.NORMAL_GENERATION.comment = Enables automatic generation of normals from the albedo. Works mostly on vanilla-style packs. §bDisabled with Lab PBR 1.3.§r

        option.NORMAL_GENERATION_RESOLUTION = Auto gen normal resolution
        option.NORMAL_GENERATION_RESOLUTION.comment = Resolution assumed for auto-generated normals. Minor effect on performance. §bOnly used when Auto gen normals is On.§r

screen.CONFIGURATION = Configuration
screen.CONFIGURATION.comment = Per-dimension features, sky, light, and fog, plus block light color. §bEvery dimension has its own copy of the same options.§r
    screen.DIMVANILLA = Vanilla dimensions
    screen.DIMVANILLA.comment = Settings for the Overworld, the Nether, and the End.
        screen.DIM0 = Overworld settings
        screen.DIM0.comment = Features, sky, light, and fog for the Overworld. Go through Features first, then Basic, then Day, Night, and Twilight, or Constant.
            screen.DIM0_FLAGS = Features
            screen.DIM0_FLAGS.comment = Turn dimension and shader features On or Off for the Overworld. §bOptions of a feature that is Off have no effect.§r
                option.WORLD0_SKYBOX = Skybox
                option.WORLD0_SKYBOX.comment = Custom skybox rendering for the Overworld.
                value.WORLD0_SKYBOX.0 = Off
                value.WORLD0_SKYBOX.1 = On

                option.WORLD0_CLOUDS = Clouds
                option.WORLD0_CLOUDS.comment = Clouds in the Overworld.
                value.WORLD0_CLOUDS.0 = Off
                value.WORLD0_CLOUDS.1 = On

                option.WORLD0_WEATHER = Weather
                option.WORLD0_WEATHER.comment = Rain and weather effects in the Overworld.
                value.WORLD0_WEATHER.0 = Off
                value.WORLD0_WEATHER.1 = On

                option.WORLD0_DAYCYCLE = Day cycle
                option.WORLD0_DAYCYCLE.comment = Day, night and twilight colors in the Overworld. §bWhen Off, the Constant settings are used instead.§r
                value.WORLD0_DAYCYCLE.0 = Off
                value.WORLD0_DAYCYCLE.1 = On

                option.WORLD0_SKYLIGHT = Real skylight
                option.WORLD0_SKYLIGHT.comment = On: use the real sky light level of the world in the Overworld. §bOff: use the fixed Skylight amount instead.§r
                value.WORLD0_SKYLIGHT.0 = Off
                value.WORLD0_SKYLIGHT.1 = On

                option.WORLD0_LIGHT = Directional light
                option.WORLD0_LIGHT.comment = Directional light (sun/moon light and shadows) in the Overworld. §bLight colors, shadows, and specular highlights only apply while this is On.§r
                value.WORLD0_LIGHT.0 = Off
                value.WORLD0_LIGHT.1 = On

                option.WORLD0_STARS = Stars
                option.WORLD0_STARS.comment = Shader star field in the Overworld (not the vanilla stars). §bStar brightness options only apply while this is On.§r
                value.WORLD0_STARS.0 = Off
                value.WORLD0_STARS.1 = On

                option.WORLD0_AETHER = Aether
                option.WORLD0_AETHER.comment = Aether glow effect in the sky of the Overworld.
                value.WORLD0_AETHER.0 = Off
                value.WORLD0_AETHER.1 = On

                option.WORLD0_SKYGROUND = Sky ground
                option.WORLD0_SKYGROUND.comment = Darkens the sky below the horizon in the Overworld.
                value.WORLD0_SKYGROUND.0 = Off
                value.WORLD0_SKYGROUND.1 = On

                option.WORLD0_VANILLAFOG = Vanilla fog color
                option.WORLD0_VANILLAFOG.comment = Uses the fog color given by the game in the Overworld as the sky color. §bVanilla fog mode and strength only apply while this is On.§r
                value.WORLD0_VANILLAFOG.0 = Off
                value.WORLD0_VANILLAFOG.1 = On

            screen.DIM0_BASIC = Basic
            screen.DIM0_BASIC.comment = Skylight, celestial body, and vanilla fog options for the Overworld. §bSkylight amount is only used when Real skylight is Off, and the vanilla fog options when Vanilla fog color is On.§r
                option.WORLD0_SKYLIGHT_I = Skylight amount
                option.WORLD0_SKYLIGHT_I.comment = Fixed skylight level in the Overworld. 0 is fully dark and 1 is fully lit. §bOnly used when Real skylight is Off.§r

                option.WORLD0_CELESTIAL = Celestial body
                option.WORLD0_CELESTIAL.comment = What is drawn in the sky of the Overworld as the sun/moon equivalent: nothing, the sun and moon, or a black hole. §bOnly drawn when Directional light is On; the Vanilla sun/moon type also needs Day cycle On.§r
                value.WORLD0_CELESTIAL.0 = None
                value.WORLD0_CELESTIAL.1 = Sun and moon
                value.WORLD0_CELESTIAL.2 = Black hole

                option.WORLD0_CELESTIAL_SIZE = Celestial size
                option.WORLD0_CELESTIAL_SIZE.comment = Size of the celestial body in the Overworld, including its reflection on shiny surfaces.

                option.WORLD0_VANILLAFOG_MODE = Vanilla fog mode
                option.WORLD0_VANILLAFOG_MODE.comment = How the vanilla fog color combines with the sky color in the Overworld. Replace ignores Strength. §bOnly used when Vanilla fog color is On.§r
