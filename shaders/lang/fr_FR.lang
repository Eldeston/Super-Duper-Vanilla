            option.SKY0_DG = Vert du ciel
            option.SKY0_DG.comment = Canal vert de la couleur du ciel du jour.
            
            option.SKY0_DB = Bleu du ciel
            option.SKY0_DB.comment = Canal bleu de la couleur du ciel du jour.
            
            option.SKY0_DI = Intensité du ciel
            option.SKY0_DI.comment = Intensité de la couleur du ciel du jour.

        screen.NIGHT_SETTINGS = Paramètres de la nuit
        screen.NIGHT_SETTINGS.comment = §1Configuration de la lumière et de la couleur du ciel nocturne.
            option.LIGHT0_NR = Rouge de la lumière
            option.LIGHT0_NR.comment = Canal rouge de la couleur de lumière nocturne.
            
            option.LIGHT0_NG = Vert de la lumière
            option.LIGHT0_NG.comment = Canal vert de la couleur de lumière nocturne.
            
            option.LIGHT0_NB = Bleu de la lumière
            option.LIGHT0_NB.comment = Canal bleu de la couleur de lumière nocturne.
            
            option.LIGHT0_NI = Intensité de la lumière
            option.LIGHT0_NI.comment = Intensité de la couleur de lumière nocturne.

            option.SKY0_NR = Rouge du ciel
            option.SKY0_NR.comment = Canal rouge de la couleur du ciel nocturne.
            
            option.SKY0_NG = Vert du ciel
            option.SKY0_NG.comment = Canal vert de la couleur du ciel nocturne.
            
            option.SKY0_NB = Bleu du ciel
            option.SKY0_NB.comment = Canal bleu de la couleur du ciel nocturne.
            
            option.SKY0_NI = Intensité du ciel
            option.SKY0_NI.comment = Intensité de la couleur du ciel nocturne.

        screen.TWILIGHT_SETTINGS = Paramètres du crépuscule
        screen.TWILIGHT_SETTINGS.comment = §dConfiguration de la lumière et de la couleur du ciel au crépuscule.
            option.LIGHT0_TR = Rouge de la lumière
            option.LIGHT0_TR.comment = Canal rouge de la couleur de lumière au crépuscule.
            
            option.LIGHT0_TG = Vert de la lumière
            option.LIGHT0_TG.comment = Canal vert de la couleur de lumière au crépuscule.
            
            option.LIGHT0_TB = Bleu de la lumière
            option.LIGHT0_TB.comment = Canal bleu de la couleur de lumière au crépuscule.
            
            option.LIGHT0_TI = Intensité de la lumière
            option.LIGHT0_TI.comment = Intensité de la couleur de lumière au crépuscule.

            option.SKY0_TR = Rouge du ciel
            option.SKY0_TR.comment = Canal rouge de la couleur du ciel au crépuscule.
            
            option.SKY0_TG = Vert du ciel
            option.SKY0_TG.comment = Canal vert de la couleur du ciel au crépuscule.
            
            option.SKY0_TB = Bleu du ciel
            option.SKY0_TB.comment = Canal bleu de la couleur du ciel au crépuscule.
            
            option.SKY0_TI = Intensité du ciel
            option.SKY0_TI.comment = Intensité de la couleur du ciel au crépuscule.

        screen.FOG_SETTINGS0 = Paramètres du brouillard
        screen.FOG_SETTINGS0.comment = §7Densité et paramètres de couleur du brouillard pour le Monde normal.
            option.FOG0_VERTICAL_DENSITY_D = Densité verticale jour
            option.FOG0_VERTICAL_DENSITY_D.comment = Densité verticale du brouillard de jour. Des valeurs plus élevées = brouillard plus fin en altitude, plus dense en bas.
            
            option.FOG0_VERTICAL_DENSITY_N = Densité verticale nuit
            option.FOG0_VERTICAL_DENSITY_N.comment = Densité verticale du brouillard de nuit.
            
            option.FOG0_VERTICAL_DENSITY_T = Densité verticale crépuscule
            option.FOG0_VERTICAL_DENSITY_T.comment = Densité verticale du brouillard au crépuscule.
            
            option.FOG0_TOTAL_DENSITY = Densité totale
            option.FOG0_TOTAL_DENSITY.comment = Densité totale du brouillard pour le Monde normal. Des valeurs plus élevées = brouillard plus épais.

            option.DYNAMIC_FOG = Brouillard dynamique
            option.DYNAMIC_FOG.comment = Active le brouillard dynamique avec des probabilités par biome selon l'humidité et suivant la météo dynamique. Les biomes humides (marais, rivières, jungles) ont souvent une brume dense, tandis que les biomes arides restent dégagés.

            option.PALE_GARDEN_FOG = Brouillard du Jardin pâle
            option.PALE_GARDEN_FOG.comment = Intensité du brouillard atmosphérique gris clair dans le biome du Jardin pâle.

    screen.NETHER_SETTINGS = Paramètres du Nether
    screen.NETHER_SETTINGS.comment = §cConfiguration du brouillard et de la couleur du ciel du Nether.
        option.FOGn1_VERTICAL_DENSITY = Densité verticale
        option.FOGn1_VERTICAL_DENSITY.comment = Densité verticale du brouillard dans le Nether. Des valeurs plus élevées = brouillard plus fin en altitude, plus dense en bas.

        option.FOGn1_TOTAL_DENSITY = Densité totale
        option.FOGn1_TOTAL_DENSITY.comment = Densité totale du brouillard pour le Nether. Des valeurs plus élevées = brouillard plus épais.

        option.WORLDn1_VANILLA_FOGCOLI = Intensité du ciel
        option.WORLDn1_VANILLA_FOGCOLI.comment = Intensité de la couleur du brouillard vanilla du Nether.

    screen.END_SETTINGS = Paramètres de l'End
    screen.END_SETTINGS.comment = §5Configuration de la lumière, du ciel et de la couleur du brouillard de la dimension de l'End.
        option.LIGHT1_CR = Rouge de la lumière
        option.LIGHT1_CR.comment = Canal rouge de la couleur de lumière de l'End.

        option.LIGHT1_CG = Vert de la lumière
        option.LIGHT1_CG.comment = Canal vert de la couleur de lumière de l'End.

        option.LIGHT1_CB = Bleu de la lumière
        option.LIGHT1_CB.comment = Canal bleu de la couleur de lumière de l'End.

        option.LIGHT1_CI = Intensité de la lumière
        option.LIGHT1_CI.comment = Intensité de la couleur de lumière de l'End.

        option.SKY1_CR = Rouge du ciel
        option.SKY1_CR.comment = Canal rouge de la couleur du ciel de l'End.

        option.SKY1_CG = Vert du ciel
        option.SKY1_CG.comment = Canal vert de la couleur du ciel de l'End.

        option.SKY1_CB = Bleu du ciel
        option.SKY1_CB.comment = Canal bleu de la couleur du ciel de l'End.

        option.SKY1_CI = Intensité ciel
        option.SKY1_CI.comment = Intensité de la couleur du ciel de l'End.

        option.WORLD1_CUSTOM_SKYLIGHT = Lumière du ciel
